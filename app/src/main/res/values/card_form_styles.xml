<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="CardFormLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">14dp</item>
        <item name="android:textColor">#C7D0DC</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="CardFormInput">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:background">@drawable/input_background</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:textColor">#FAF8F2</item>
        <item name="android:textColorHint">#95A1B3</item>
        <item name="android:textSize">16sp</item>
        <item name="android:singleLine">true</item>
        <item name="android:inputType">textCapSentences</item>
    </style>
    <style name="CardFormPrimary">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:background">@drawable/button_gold</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:textColor">#0B1220</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="CardFormSecondary" parent="CardFormPrimary">
        <item name="android:background">@drawable/button_outline</item>
        <item name="android:textColor">#E2B74D</item>
    </style>
    <style name="CardGameTile">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">116dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:padding">16dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:background">@drawable/binder_panel</item>
        <item name="android:foreground">?android:attr/selectableItemBackground</item>
    </style>
    <style name="CardFormPreview">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">300dp</item>
        <item name="android:src">@drawable/deckbid_card_placeholder</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:contentDescription">Card preview</item>
    </style>
</resources>
