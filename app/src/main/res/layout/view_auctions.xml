<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">
    <EditText
        android:id="@+id/auction_search"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="16dp"
        android:padding="14dp"
        android:background="@drawable/input_background"
        android:hint="Search cards or keywords…"
        android:textColor="#FAF8F2"
        android:textColorHint="#95A1B3"
        android:textSize="14sp"
        android:singleLine="true"
        android:inputType="text"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="12dp">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_margin="3dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Category"
                android:textSize="11sp"
                android:textColor="#95A1B3"
                android:layout_marginBottom="5dp"/>
            <Spinner
                android:id="@+id/auction_category"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/input_background"
                android:popupBackground="#182334"
                android:spinnerMode="dropdown"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_margin="3dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Condition"
                android:textSize="11sp"
                android:textColor="#95A1B3"
                android:layout_marginBottom="5dp"/>
            <Spinner
                android:id="@+id/auction_condition"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/input_background"
                android:popupBackground="#182334"
                android:spinnerMode="dropdown"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="6dp">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_margin="3dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Current bid"
                android:textSize="11sp"
                android:textColor="#95A1B3"
                android:layout_marginBottom="5dp"/>
            <Spinner
                android:id="@+id/auction_price"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/input_background"
                android:popupBackground="#182334"
                android:spinnerMode="dropdown"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_margin="3dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Sort by"
                android:textSize="11sp"
                android:textColor="#95A1B3"
                android:layout_marginBottom="5dp"/>
            <Spinner
                android:id="@+id/auction_sort"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/input_background"
                android:popupBackground="#182334"
                android:spinnerMode="dropdown"/>
        </LinearLayout>
    </LinearLayout>
    <TextView
        android:id="@+id/auction_result_count"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="20 auctions · All listings"
        android:textSize="12sp"
        android:textColor="#95A1B3"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="12dp"/>
    <Button
        android:id="@+id/auction_clear"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:background="@android:color/transparent"
        android:text="Clear filters"
        android:textColor="#D4A63A"
        android:textAllCaps="false"/>
    <GridLayout
        android:id="@+id/auction_grid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="2"/>
    <TextView
        android:id="@+id/auction_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No auctions match these filters."
        android:textSize="14sp"
        android:textColor="#95A1B3"
        android:visibility="gone"
        android:padding="20dp"
        android:gravity="center"/>
</LinearLayout>
