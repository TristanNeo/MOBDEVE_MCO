<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">
    <EditText
        android:id="@+id/auction_search"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="16dp"
        android:padding="14dp"
        android:background="@drawable/input_background"
        android:hint="Search cards or keywords…"
        android:textColor="#FAF8F2"
        android:textColorHint="#95A1B3"
        android:textSize="14sp"
        android:singleLine="true"
        android:inputType="text"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">
        <Spinner
            android:id="@+id/auction_category"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="44dp"
            android:layout_marginStart="0dp"
            android:spinnerMode="dropdown"
            android:dropDownWidth="180dp"
            android:background="@drawable/input_background"
            android:popupBackground="#182334"/>
        <Spinner
            android:id="@+id/auction_condition"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="44dp"
            android:layout_marginStart="6dp"
            android:spinnerMode="dropdown"
            android:dropDownWidth="180dp"
            android:background="@drawable/input_background"
            android:popupBackground="#182334"/>
        <Spinner
            android:id="@+id/auction_price"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="44dp"
            android:layout_marginStart="6dp"
            android:spinnerMode="dropdown"
            android:dropDownWidth="180dp"
            android:background="@drawable/input_background"
            android:popupBackground="#182334"/>
    </LinearLayout>
    <Button
        android:id="@+id/auction_clear"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="44dp"
        android:layout_gravity="end"
        android:background="?android:attr/selectableItemBackground"
        android:text="Clear filters"
        android:textColor="#D4A63A"
        android:textAllCaps="false"/>
    <TextView android:id="@+id/my_auctions_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:layout_marginBottom="12dp" android:text="My Auctions" android:textColor="#FAF8F2" android:textSize="20sp" android:textStyle="bold"/>
    <LinearLayout android:id="@+id/my_auction_rows" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
    <TextView android:id="@+id/my_auctions_empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Choose a card in your Binder to create an auction." android:textColor="#95A1B3" android:paddingTop="8dp" android:paddingBottom="16dp"/>
    <TextView android:id="@+id/live_auctions_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:layout_marginBottom="12dp" android:text="Live Auctions" android:textColor="#FAF8F2" android:textSize="20sp" android:textStyle="bold"/>
    <GridLayout
        android:id="@+id/auction_grid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="2"/>
    <TextView
        android:id="@+id/auction_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No auctions match these filters."
        android:textSize="14sp"
        android:textColor="#95A1B3"
        android:visibility="gone"
        android:padding="20dp"
        android:gravity="center"/>
</LinearLayout>
