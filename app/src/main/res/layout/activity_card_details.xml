<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0B1220"
    android:fitsSystemWindows="true">
    <Button
        android:id="@+id/back_button"
        android:layout_width="wrap_content"
        android:layout_height="56dp"
        android:background="@android:color/transparent"
        android:text="‹  Card Details"
        android:textAllCaps="false"
        android:textSize="20sp"
        android:textColor="#FAF8F2"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"/>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:baselineAligned="false">
                <ImageView
                    android:id="@+id/detail_image"
                    android:layout_width="104dp"
                    android:layout_height="156dp"
                    android:scaleType="fitCenter"/>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="16dp"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/detail_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Card"
                        android:textSize="20sp"
                        android:textColor="#FAF8F2"
                        android:textStyle="bold"/>
                    <TextView
                        android:id="@+id/detail_set"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textSize="14sp"
                        android:textColor="#BAC5D3"/>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:baselineAligned="false"
                        android:clipToPadding="false">
                        <ImageView
                            android:id="@+id/detail_game_logo"
                            android:layout_width="68dp"
                            android:layout_height="32dp"
                            android:scaleType="fitCenter"/>
                        <TextView
                            android:id="@+id/detail_condition"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:elevation="3dp"
                            android:textSize="13sp"/>
                    </LinearLayout>
                    <View
                        android:id="@+id/card_status_divider"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="6dp"
                        android:background="#293548"/>
                    <TextView
                        android:id="@+id/card_auction_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="#EFCD77"
                        android:textSize="14sp"
                        android:visibility="gone"/>
                    <TextView
                        android:id="@+id/card_auction_clock"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="#D6DCE4"
                        android:textSize="13sp"
                        android:visibility="gone"/>

                </LinearLayout>
            </LinearLayout>
            <Button
                android:id="@+id/card_auction_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:minWidth="152dp"
                android:minHeight="50dp"
                android:paddingStart="26dp"
                android:paddingEnd="26dp"
                android:background="@drawable/button_gold"
                android:backgroundTint="@null"
                android:text="Auction Card"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#0B1220"
                android:textAllCaps="false"
                android:visibility="gone"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Average Auction Value"
                android:textSize="14sp"
                android:textColor="#95A1B3"
                android:layout_marginTop="20dp"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:id="@+id/detail_value"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="30sp"
                    android:textStyle="bold"
                    android:textColor="#FAF8F2"/>
                <TextView
                    android:id="@+id/detail_change"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="16sp"
                    android:textColor="#4CD6A0"/>
            </LinearLayout>
            <TextView
                android:id="@+id/detail_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No completed auctions for this card and condition."
                android:textSize="11sp"
                android:textColor="#95A1B3"
                android:layout_marginTop="4dp"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Top 5 Highest Auctions"
                android:textSize="18sp"
                android:textColor="#FAF8F2"
                android:textStyle="bold"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="12dp"/>
            <LinearLayout
                android:id="@+id/highest_table"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="8dp"
                android:background="@drawable/binder_panel"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Active Auctions · up to 5"
                android:textSize="18sp"
                android:textColor="#FAF8F2"
                android:textStyle="bold"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="12dp"/>
            <LinearLayout
                android:id="@+id/active_table"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="8dp"
                android:background="@drawable/binder_panel"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
