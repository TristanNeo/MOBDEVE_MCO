<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0B1220"
    android:fitsSystemWindows="true">
    <Button
        android:id="@+id/back_button"
        android:layout_width="wrap_content"
        android:layout_height="56dp"
        android:background="@android:color/transparent"
        android:text="‹  Card Details"
        android:textAllCaps="false"
        android:textSize="20sp"
        android:textColor="#FAF8F2"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"/>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <ImageView
                    android:id="@+id/detail_image"
                    android:layout_width="120dp"
                    android:layout_height="190dp"
                    android:scaleType="fitCenter"/>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="16dp"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/detail_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Card"
                        android:textSize="20sp"
                        android:textColor="#FAF8F2"
                        android:textStyle="bold"/>
                    <TextView
                        android:id="@+id/detail_set"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Set"
                        android:textSize="13sp"
                        android:textColor="#95A1B3"
                        android:layout_marginTop="6dp"/>
                    <Spinner
                        android:id="@+id/detail_condition"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/input_background"
                        android:popupBackground="#182334"
                        android:spinnerMode="dropdown"/>
                </LinearLayout>
            </LinearLayout>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Average Auction Value"
                android:textSize="14sp"
                android:textColor="#95A1B3"
                android:layout_marginTop="20dp"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:id="@+id/detail_value"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="30sp"
                    android:textStyle="bold"
                    android:textColor="#FAF8F2"/>
                <TextView
                    android:id="@+id/detail_change"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="16sp"
                    android:textColor="#4CD6A0"/>
            </LinearLayout>
            <TextView
                android:id="@+id/detail_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Change vs. previous 30 days"
                android:textSize="11sp"
                android:textColor="#95A1B3"
                android:layout_marginTop="4dp"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Top 5 Highest Auctions"
                android:textSize="18sp"
                android:textColor="#FAF8F2"
                android:textStyle="bold"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="12dp"/>
            <LinearLayout
                android:id="@+id/highest_table"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="8dp"
                android:background="@drawable/binder_panel"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Active Auctions · up to 5"
                android:textSize="18sp"
                android:textColor="#FAF8F2"
                android:textStyle="bold"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="12dp"/>
            <LinearLayout
                android:id="@+id/active_table"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="8dp"
                android:background="@drawable/binder_panel"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
