<?xml version="1.0" encoding="utf-8"?>
<RadioGroup xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/home_auction_roles"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:layout_marginBottom="10dp"
    android:orientation="horizontal"
    android:background="@drawable/binder_panel"
    android:padding="3dp">
    <RadioButton
        android:id="@+id/home_selling"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:minHeight="44dp"
        android:padding="6dp"
        android:button="@null"
        android:gravity="center"
        android:background="@drawable/home_auction_role"
        android:backgroundTint="@null"
        android:text="Selling"
        android:textSize="14sp"
        android:textColor="@color/auction_role_text"/>
    <RadioButton
        android:id="@+id/home_bidding"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:minHeight="44dp"
        android:padding="6dp"
        android:button="@null"
        android:gravity="center"
        android:background="@drawable/home_auction_role"
        android:backgroundTint="@null"
        android:text="Bidding"
        android:textSize="14sp"
        android:textColor="@color/auction_role_text"/>
</RadioGroup>
