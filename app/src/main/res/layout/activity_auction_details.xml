<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:fitsSystemWindows="true"
        android:background="#0B1220">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <Button
        android:id="@+id/auction_back"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:background="@android:color/transparent"
        android:backgroundTint="@null"
        android:text="‹  Auction Details"
        android:textSize="20sp"
        android:textAllCaps="false"
        android:textColor="#FAF8F2"
        android:layout_weight="1"
        android:gravity="start|center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp" />
        <ImageButton
        android:id="@+id/auction_save"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|end"
        android:padding="13dp"
        android:src="@drawable/auction_heart"
        android:background="?android:attr/selectableItemBackground"
        android:contentDescription="Save to watchlist" />
    </LinearLayout>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">
            <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="top">
                <ImageView
        android:id="@+id/detail_auction_image"
        android:layout_width="104dp"
        android:layout_height="158dp"
        android:scaleType="fitCenter"
        android:layout_marginTop="2dp" />
                <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:orientation="vertical">
                    <TextView
        android:id="@+id/detail_auction_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Card"
        android:textSize="19sp"
        android:textColor="#FAF8F2"
        android:textStyle="bold" />
                    <TextView
        android:id="@+id/detail_auction_game"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Game"
        android:textSize="11sp"
        android:textColor="#95A1B3"
        android:layout_marginTop="3dp" />
                    <TextView
        android:id="@+id/detail_auction_grade"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Ungraded"
        android:textSize="10sp"
        android:textColor="#D4A63A"
        android:layout_marginTop="5dp"
        android:background="@drawable/input_background"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp" />
                    <TextView
        android:id="@+id/detail_auction_seller"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Seller"
        android:textSize="11sp"
        android:textColor="#95A1B3"
        android:layout_marginTop="5dp" />
                    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="top"
        android:layout_marginTop="8dp"
        android:baselineAligned="false">
                        <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.2"
        android:orientation="vertical"
        android:gravity="top"
        android:baselineAligned="false">
                            <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Current Bid"
        android:textSize="10sp"
        android:textColor="#95A1B3"
        android:includeFontPadding="false" />
                            <TextView
        android:id="@+id/detail_auction_bid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="₱0"
        android:textSize="23sp"
        android:textColor="#FAF8F2"
        android:textStyle="bold"
        android:includeFontPadding="false"
        android:layout_marginTop="4dp" />
                        </LinearLayout>
                        <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_weight="1"
        android:paddingStart="8dp"
        android:gravity="top"
        android:baselineAligned="false">
                            <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Starting bid"
        android:textSize="10sp"
        android:textColor="#95A1B3"
        android:layout_marginTop="0dp"
        android:includeFontPadding="false" />
                            <TextView
        android:id="@+id/detail_auction_start"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Starting bid"
        android:textSize="14sp"
        android:textColor="#FAF8F2"
        android:layout_marginTop="4dp"
        android:textStyle="bold"
        android:includeFontPadding="false" />
                            <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Bid increment"
        android:textSize="10sp"
        android:textColor="#95A1B3"
        android:layout_marginTop="8dp"
        android:includeFontPadding="false" />
                            <TextView
        android:id="@+id/detail_auction_increment"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Increment"
        android:textSize="14sp"
        android:textColor="#FAF8F2"
        android:layout_marginTop="2dp"
        android:textStyle="bold"
        android:includeFontPadding="false" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:layout_marginTop="16dp">
                <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#293548" />
                <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Time remaining"
        android:textColor="#95A1B3"
        android:textSize="12sp"
        android:gravity="center"
        android:layout_marginTop="16dp" />
                <TextView
        android:id="@+id/detail_auction_time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="1h 58m left"
        android:textColor="#D4A63A"
        android:textSize="28sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginTop="4dp" />
                <TextView
        android:id="@+id/detail_auction_count"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="6 bids"
        android:textColor="#FAF8F2"
        android:textSize="16sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp" />
            </LinearLayout>
            <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="12dp"
        android:baselineAligned="false">
                <Button
        android:id="@+id/auction_auto_bid"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:background="@drawable/button_outline"
        android:backgroundTint="@null"
        android:text="Auto-Bid"
        android:textSize="16sp"
        android:textAllCaps="false"
        android:textColor="#D4A63A"
        android:layout_weight="1"
        android:layout_marginEnd="6dp"
        android:textStyle="bold"
        android:gravity="center"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:minWidth="0dp" />
                <Button
        android:id="@+id/auction_place_bid"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:background="@drawable/button_gold"
        android:backgroundTint="@null"
        android:text="Place Bid"
        android:textSize="16sp"
        android:textAllCaps="false"
        android:textColor="#0B1220"
        android:layout_weight="1"
        android:layout_marginStart="6dp"
        android:textStyle="bold"
        android:gravity="center"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:minWidth="0dp" />
            </LinearLayout>
            <TextView
        android:id="@+id/detail_auction_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="11sp"
        android:textColor="#D4A63A"
        android:layout_marginTop="8dp" />
            <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/binder_panel"
        android:padding="14dp"
        android:layout_marginTop="20dp">
                <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Auction Summary"
        android:textSize="18sp"
        android:textColor="#FAF8F2"
        android:textStyle="bold"
        android:layout_marginBottom="10dp" />
                <LinearLayout
        android:id="@+id/auction_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />
            </LinearLayout>
            <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Bid History"
        android:textSize="18sp"
        android:textColor="#FAF8F2"
        android:textStyle="bold"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="12dp" />
            <LinearLayout
        android:id="@+id/auction_history"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/binder_panel"
        android:padding="6dp" />
            <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="20dp"
        android:background="@drawable/binder_panel"
        android:padding="14dp">
                <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Seller Notes"
        android:textSize="18sp"
        android:textColor="#FAF8F2"
        android:textStyle="bold" />
                <TextView
        android:id="@+id/auction_notes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Notes"
        android:textSize="13sp"
        android:textColor="#95A1B3"
        android:layout_marginTop="8dp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
