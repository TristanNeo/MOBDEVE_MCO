<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/binder_panel"
    android:padding="10dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="164dp">
        <ImageView
            android:id="@+id/auction_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:padding="6dp"/>
        <ImageButton
            android:id="@+id/auction_save"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="top|end"
            android:padding="13dp"
            android:src="@drawable/auction_heart"
            android:background="?android:attr/selectableItemBackground"
            android:contentDescription="Save to watchlist"/>
    </FrameLayout>
    <TextView
        android:id="@+id/auction_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Card"
        android:textSize="14sp"
        android:textColor="#FAF8F2"
        android:minLines="2"
        android:maxLines="2"
        android:ellipsize="end"
        android:textStyle="bold"
        android:layout_marginTop="8dp"/>
    <TextView
        android:id="@+id/auction_game"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Game"
        android:textSize="11sp"
        android:textColor="#95A1B3"
        android:maxLines="1"
        android:ellipsize="end"/>
    <TextView
        android:id="@+id/auction_grade"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ungraded"
        android:textSize="11sp"
        android:textColor="#D4A63A"
        android:layout_marginTop="6dp"/>
    <TextView
        android:id="@+id/auction_bid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="₱0"
        android:textSize="18sp"
        android:textColor="#FAF8F2"
        android:textStyle="bold"
        android:layout_marginTop="10dp"/>
    <TextView
        android:id="@+id/auction_bid_count"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="0 bids"
        android:textSize="11sp"
        android:textColor="#95A1B3"
        android:layout_marginTop="3dp"/>
    <TextView
        android:id="@+id/auction_time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Time left"
        android:textSize="12sp"
        android:textColor="#F2B879"
        android:layout_marginTop="6dp"/>
</LinearLayout>
