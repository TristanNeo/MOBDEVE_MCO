<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="#0B1220" android:fitsSystemWindows="true">
<Button android:id="@+id/back_button" android:layout_width="wrap_content" android:layout_height="56dp" android:background="@android:color/transparent" android:text="‹  Create Auction" android:textAllCaps="false" android:textSize="20sp" android:textColor="#FAF8F2" android:paddingStart="20dp" android:paddingEnd="20dp"/>
<ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp" android:focusableInTouchMode="true">
<ImageView android:id="@+id/create_card_image" android:layout_width="match_parent" android:layout_height="180dp" android:scaleType="fitCenter" android:contentDescription="Your Binder card"/>
<TextView android:id="@+id/create_card_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:textColor="#FAF8F2" android:textSize="22sp" android:textStyle="bold"/>
<TextView android:id="@+id/create_card_details" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="#95A1B3" android:textSize="14sp"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Starting bid (₱)" android:textColor="#95A1B3" android:textSize="14sp" android:layout_marginTop="16dp" android:layout_marginBottom="6dp"/><EditText android:id="@+id/create_starting_bid" android:layout_width="match_parent" android:layout_height="52dp" android:background="@drawable/input_background" android:padding="14dp" android:textColor="#FAF8F2" android:textColorHint="#95A1B3" android:textSize="14sp" android:hint="Starting bid" android:inputType="number" android:singleLine="true" android:text="" android:maxLength="9"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Bid increment (₱)" android:textColor="#95A1B3" android:textSize="14sp" android:layout_marginTop="16dp" android:layout_marginBottom="6dp"/><EditText android:id="@+id/create_increment" android:layout_width="match_parent" android:layout_height="52dp" android:background="@drawable/input_background" android:padding="14dp" android:textColor="#FAF8F2" android:textColorHint="#95A1B3" android:textSize="14sp" android:hint="Bid increment" android:inputType="number" android:singleLine="true" android:text="50" android:maxLength="9"/><CheckBox android:id="@+id/create_start_now" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="16dp" android:checked="true" android:text="Start immediately" android:textColor="#FAF8F2" android:buttonTint="#D4A63A"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Start date and time (device local time)" android:textColor="#95A1B3" android:textSize="14sp" android:layout_marginTop="16dp" android:layout_marginBottom="6dp"/><Button android:id="@+id/create_start_date" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="12dp" android:background="@drawable/button_outline" android:backgroundTint="@null" android:text="Choose date" android:textAllCaps="false" android:textColor="#D4A63A"/><Button android:id="@+id/create_start_time" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="12dp" android:background="@drawable/button_outline" android:backgroundTint="@null" android:text="Choose time" android:textAllCaps="false" android:textColor="#D4A63A"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Duration · maximum 7 days" android:textColor="#95A1B3" android:textSize="14sp" android:layout_marginTop="16dp" android:layout_marginBottom="6dp"/><EditText android:id="@+id/create_duration" android:layout_width="match_parent" android:layout_height="52dp" android:background="@drawable/input_background" android:padding="14dp" android:textColor="#FAF8F2" android:textColorHint="#95A1B3" android:textSize="14sp" android:hint="Duration" android:inputType="number" android:singleLine="true" android:text="1" android:maxLength="3"/><Spinner android:id="@+id/create_duration_unit" android:layout_width="match_parent" android:layout_height="52dp" android:background="@drawable/input_background" android:popupBackground="#182334" android:spinnerMode="dropdown"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Seller notes (optional)" android:textColor="#95A1B3" android:textSize="14sp" android:layout_marginTop="16dp" android:layout_marginBottom="6dp"/><EditText android:id="@+id/create_notes" android:layout_width="match_parent" android:layout_height="52dp" android:background="@drawable/input_background" android:padding="14dp" android:textColor="#FAF8F2" android:textColorHint="#95A1B3" android:textSize="14sp" android:hint="Add details for bidders" android:inputType="textCapSentences" android:singleLine="true" android:text="" android:maxLength="1000"/><Button android:id="@+id/create_auction_submit" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="12dp" android:background="@drawable/button_gold" android:backgroundTint="@null" android:text="Create auction" android:textAllCaps="false" android:textColor="#0B1220"/>
</LinearLayout></ScrollView></LinearLayout>
