<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:paddingTop="16dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp">
        <ImageView style="@style/CardFormPreview" android:id="@+id/add_preview"/>
        <Button
            style="@style/CardFormSecondary"
            android:id="@+id/pick_photo_button"
            android:text="Choose photo from device"
            android:layout_marginTop="12dp"/>
        <TextView
            style="@style/CardFormLabel"
            android:text="Card name"
            android:labelFor="@id/add_name"/>
        <EditText
            style="@style/CardFormInput"
            android:id="@+id/add_name"
            android:hint="Enter card name"
            android:maxLength="80"/>
        <TextView
            style="@style/CardFormLabel"
            android:text="Set"
            android:labelFor="@id/add_set"/>
        <EditText
            style="@style/CardFormInput"
            android:id="@+id/add_set"
            android:hint="Enter set"
            android:maxLength="80"/>
        <include layout="@layout/add_card_condition"/>
        <Button
            style="@style/CardFormPrimary"
            android:id="@+id/submit_new_card"
            android:layout_marginTop="18dp"
            android:text="Add to Binder"/>
    </LinearLayout>
</ScrollView>
