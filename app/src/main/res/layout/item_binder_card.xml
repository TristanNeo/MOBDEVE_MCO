<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="10dp"
    android:background="@drawable/binder_panel"
    android:foreground="?android:attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true">
    <ImageView
        android:id="@+id/card_image"
        android:layout_width="match_parent"
        android:layout_height="172dp"
        android:scaleType="fitCenter"/>
    <TextView
        android:id="@+id/card_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Card name"
        android:textSize="15sp"
        android:textColor="#FAF8F2"
        android:layout_marginTop="10dp"
        android:textStyle="bold"
        android:minLines="2"
        android:maxLines="2"
        android:ellipsize="end"/>
    <TextView
        android:id="@+id/card_set"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Set"
        android:textSize="12sp"
        android:textColor="#95A1B3"
        android:minLines="2"
        android:maxLines="2"
        android:ellipsize="end"/>
    <TextView
        android:id="@+id/card_condition"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ungraded"
        android:textSize="11sp"
        android:textColor="#D4A63A"
        android:layout_marginTop="6dp"/>
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Avg. auction value"
        android:textSize="10sp"
        android:textColor="#95A1B3"
        android:layout_marginTop="10dp"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:id="@+id/card_value"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#FAF8F2"/>
        <TextView
            android:id="@+id/card_change"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:textSize="10sp"
            android:textColor="#4CD6A0"/>
    </LinearLayout>
</LinearLayout>
