<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/binder_panel"
        android:padding="16dp">
        <TextView
            android:id="@+id/home_greeting"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Welcome back,"
            android:textSize="13sp"
            android:textColor="#95A1B3"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Collector"
            android:textSize="26sp"
            android:textColor="#FAF8F2"
            android:textStyle="bold"
            android:layout_marginTop="4dp"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Your collection. Your next bid."
            android:textSize="13sp"
            android:textColor="#95A1B3"
            android:layout_marginTop="6dp"/>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="12dp"
        android:background="@drawable/binder_panel">
        <TextView
            android:id="@+id/home_binder_stat"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="0 Cards"
            android:textSize="12sp"
            android:textColor="#FAF8F2"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground"/>
        <TextView
            android:id="@+id/home_watch_stat"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="0 Saved"
            android:textSize="12sp"
            android:textColor="#FAF8F2"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground"/>
        <TextView
            android:id="@+id/home_bids_stat"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="0 Bidding"
            android:textSize="12sp"
            android:textColor="#FAF8F2"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground"/>
        <TextView
            android:id="@+id/home_won_stat"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="0 Won"
            android:textSize="12sp"
            android:textColor="#FAF8F2"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground"/>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/binder_panel"
        android:padding="16dp"
        android:layout_marginTop="16dp">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Find your next card"
            android:textSize="20sp"
            android:textColor="#FAF8F2"
            android:textStyle="bold"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Browse auctions across your favourite card games."
            android:textSize="13sp"
            android:textColor="#95A1B3"
            android:layout_marginTop="6dp"/>
        <Button
            android:id="@+id/home_browse"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/button_gold"
            android:backgroundTint="@null"
            android:text="View Auctions  →"
            android:textSize="14sp"
            android:textAllCaps="false"
            android:textColor="#0B1220"
            android:layout_marginTop="14dp"/>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="12dp">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Ending Soon"
            android:textSize="19sp"
            android:textColor="#FAF8F2"
            android:layout_weight="1"
            android:textStyle="bold"/>
        <Button
            android:id="@+id/home_see_all"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:background="@drawable/button_outline"
            android:backgroundTint="@null"
            android:text="See all"
            android:textSize="14sp"
            android:textAllCaps="false"
            android:textColor="#D4A63A"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"/>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/home_ending_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"/>
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Browse by Category"
        android:textSize="19sp"
        android:textColor="#FAF8F2"
        android:textStyle="bold"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="10dp"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <LinearLayout
            android:id="@+id/category_pokemon"
            android:layout_width="0dp"
            android:layout_height="96dp"
            android:layout_weight="1"
            android:layout_margin="3dp"
            android:background="@drawable/binder_panel"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="5dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground">
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:src="@drawable/logo_pokemon"
                android:scaleType="fitCenter"
                android:importantForAccessibility="no"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Pokémon"
                android:textSize="10sp"
                android:textColor="#FAF8F2"
                android:gravity="center"
                android:layout_marginTop="8dp"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/category_onepiece"
            android:layout_width="0dp"
            android:layout_height="96dp"
            android:layout_weight="1"
            android:layout_margin="3dp"
            android:background="@drawable/binder_panel"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="5dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground">
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:src="@drawable/logo_one_piece"
                android:scaleType="fitCenter"
                android:importantForAccessibility="no"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="One Piece"
                android:textSize="10sp"
                android:textColor="#FAF8F2"
                android:gravity="center"
                android:layout_marginTop="8dp"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/category_yugioh"
            android:layout_width="0dp"
            android:layout_height="96dp"
            android:layout_weight="1"
            android:layout_margin="3dp"
            android:background="@drawable/binder_panel"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="5dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground">
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:src="@drawable/logo_yugioh"
                android:scaleType="fitCenter"
                android:importantForAccessibility="no"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Yu-Gi-Oh!"
                android:textSize="10sp"
                android:textColor="#FAF8F2"
                android:gravity="center"
                android:layout_marginTop="8dp"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/category_mtg"
            android:layout_width="0dp"
            android:layout_height="96dp"
            android:layout_weight="1"
            android:layout_margin="3dp"
            android:background="@drawable/binder_panel"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="5dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground">
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:src="@drawable/logo_mtg"
                android:scaleType="fitCenter"
                android:importantForAccessibility="no"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Magic"
                android:textSize="10sp"
                android:textColor="#FAF8F2"
                android:gravity="center"
                android:layout_marginTop="8dp"/>
        </LinearLayout>
    </LinearLayout>
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Demo auctions · bids are stored on this device"
        android:textSize="11sp"
        android:textColor="#95A1B3"
        android:layout_marginTop="12dp"/>
</LinearLayout>
