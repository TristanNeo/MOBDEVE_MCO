<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/binder_panel"
        android:padding="20dp"
        android:layout_marginTop="16dp">
    <FrameLayout
        android:layout_width="104dp"
        android:layout_height="104dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/auction_avatar">
        <TextView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:text=""
        android:textSize="32sp"
        android:textColor="#D4A63A"
        android:id="@+id/profile_initial"
        android:gravity="center" />
        <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:id="@+id/profile_photo"
        android:scaleType="centerCrop"
        android:importantForAccessibility="no"
        android:background="@drawable/auction_avatar"
        android:contentDescription="Your profile picture" />
    </FrameLayout>
    <Button
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:id="@+id/upload_photo"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:background="@drawable/button_outline"
        android:backgroundTint="@null"
        android:text="Upload photo"
        android:textAllCaps="false"
        android:textColor="#D4A63A"
        android:textSize="14sp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp" />
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Username"
        android:textSize="12sp"
        android:textColor="#95A1B3"
        android:layout_marginTop="20dp" />
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="17sp"
        android:textColor="#FAF8F2"
        android:id="@+id/profile_username"
        android:layout_marginTop="5dp"
        android:textIsSelectable="true" />
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Birthday"
        android:textSize="12sp"
        android:textColor="#95A1B3"
        android:layout_marginTop="20dp" />
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="17sp"
        android:textColor="#FAF8F2"
        android:id="@+id/profile_birthday"
        android:layout_marginTop="5dp"
        android:textIsSelectable="true" />
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Email address"
        android:textSize="12sp"
        android:textColor="#95A1B3"
        android:layout_marginTop="20dp" />
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="17sp"
        android:textColor="#FAF8F2"
        android:id="@+id/profile_email"
        android:layout_marginTop="5dp"
        android:textIsSelectable="true" />
</LinearLayout>
