<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingEnd="20dp">
    <TextView
        style="@style/CardFormLabel"
        android:text="Card name"
        android:labelFor="@id/card_catalog_search"/>
    <EditText
        style="@style/CardFormInput"
        android:id="@+id/card_catalog_search"
        android:hint="Search by card name"
        android:saveEnabled="false"
        android:imeOptions="actionDone"/>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="4dp">
        <ScrollView
            android:id="@+id/card_search_scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="16dp">
                <ImageView
                    android:id="@+id/add_preview"
                    android:layout_width="match_parent"
                    android:layout_height="196dp"
                    android:layout_marginTop="12dp"
                    android:src="@drawable/deckbid_card_placeholder"
                    android:scaleType="fitCenter"
                    android:contentDescription="Card preview"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:id="@+id/edition_fields"
                    android:visibility="gone">
                    <TextView style="@style/CardFormLabel" android:text="Set"/>
                    <TextView
                        android:id="@+id/edition_set"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="#FAF8F2"
                        android:textSize="16sp"
                        android:textIsSelectable="true"/>
                    <include layout="@layout/add_card_condition"/>
                    <Button
                        style="@style/CardFormPrimary"
                        android:id="@+id/save_card_button"
                        android:text="Add to Binder"
                        android:layout_marginTop="18dp"/>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
        <ListView
            android:id="@+id/card_suggestions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:background="@drawable/input_background"
            android:elevation="4dp"
            android:divider="#293E54"
            android:dividerHeight="1dp"
            android:visibility="gone"/>
    </FrameLayout>
</LinearLayout>
