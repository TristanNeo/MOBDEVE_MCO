<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:padding="20dp">
        <TextView
            style="@style/CardFormLabel"
            android:gravity="center"
            android:text="Choose a trading card game"
            android:textColor="#FAF8F2"
            android:textSize="22sp"
            android:layout_marginTop="0dp"
            android:layout_marginBottom="18dp"/>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">
            <ImageButton
                style="@style/CardGameTile"
                android:id="@+id/select_pokemon"
                android:src="@drawable/logo_pokemon"
                android:contentDescription="Pokémon"
                android:layout_marginStart="0dp"/>
            <ImageButton
                style="@style/CardGameTile"
                android:id="@+id/select_onepiece"
                android:src="@drawable/logo_one_piece"
                android:contentDescription="One Piece"
                android:layout_marginStart="12dp"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">
            <ImageButton
                style="@style/CardGameTile"
                android:id="@+id/select_yugioh"
                android:src="@drawable/logo_yugioh"
                android:contentDescription="Yu-Gi-Oh!"
                android:layout_marginStart="0dp"/>
            <ImageButton
                style="@style/CardGameTile"
                android:id="@+id/select_magic"
                android:src="@drawable/logo_mtg"
                android:contentDescription="Magic: The Gathering"
                android:layout_marginStart="12dp"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
