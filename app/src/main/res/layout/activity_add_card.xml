<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0B1220"
    android:fitsSystemWindows="true">
    <Button
        android:id="@+id/back_button"
        android:layout_width="wrap_content"
        android:layout_height="56dp"
        android:background="@android:color/transparent"
        android:text="‹  Add Card"
        android:textAllCaps="false"
        android:textSize="20sp"
        android:textColor="#FAF8F2"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"/>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:focusableInTouchMode="true">
            <ImageView
                android:id="@+id/add_preview"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:scaleType="fitCenter"
                android:contentDescription="Selected card photo"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Card artwork"
                android:textSize="14sp"
                android:textColor="#FAF8F2"
                android:layout_marginTop="16dp"/>
            <Spinner
                android:id="@+id/artwork_spinner"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/input_background"
                android:popupBackground="#182334"
                android:spinnerMode="dropdown"/>
            <Button
                android:id="@+id/pick_photo_button"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/button_outline"
                android:backgroundTint="@null"
                android:text="Choose photo from device"
                android:textAllCaps="false"
                android:textColor="#D4A63A"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Card name"
                android:textSize="14sp"
                android:textColor="#FAF8F2"
                android:layout_marginTop="18dp"/>
            <EditText
                android:id="@+id/add_name"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:padding="14dp"
                android:background="@drawable/input_background"
                android:hint="e.g. Snorlax ex"
                android:textColor="#FAF8F2"
                android:textColorHint="#95A1B3"
                android:textSize="14sp"
                android:inputType="textCapSentences"
                android:maxLength="80"
                android:singleLine="true"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Trading card game"
                android:textSize="14sp"
                android:textColor="#FAF8F2"
                android:layout_marginTop="16dp"/>
            <Spinner
                android:id="@+id/game_spinner"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/input_background"
                android:popupBackground="#182334"
                android:spinnerMode="dropdown"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Set / card number"
                android:textSize="14sp"
                android:textColor="#FAF8F2"
                android:layout_marginTop="16dp"/>
            <EditText
                android:id="@+id/add_set"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:padding="14dp"
                android:background="@drawable/input_background"
                android:hint="e.g. Scarlet &amp; Violet · 076/165"
                android:textColor="#FAF8F2"
                android:textColorHint="#95A1B3"
                android:textSize="14sp"
                android:inputType="textCapSentences"
                android:maxLength="80"
                android:singleLine="true"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Condition"
                android:textSize="14sp"
                android:textColor="#FAF8F2"
                android:layout_marginTop="16dp"/>
            <Spinner
                android:id="@+id/condition_spinner"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/input_background"
                android:popupBackground="#182334"
                android:spinnerMode="dropdown"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Auction values appear when matching auction history is available."
                android:textSize="12sp"
                android:textColor="#95A1B3"
                android:layout_marginTop="16dp"/>
            <Button
                android:id="@+id/save_card_button"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/button_gold"
                android:backgroundTint="@null"
                android:text="Add to Binder"
                android:textColor="#0B1220"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="12dp"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
