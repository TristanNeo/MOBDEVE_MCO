<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0B1220"
    android:fitsSystemWindows="true"
    android:focusableInTouchMode="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="52dp"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="20dp">
        <Button
            style="@style/CardFormPrimary"
            android:id="@+id/back_button"
            android:text="‹"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:textColor="#FAF8F2"
            android:textSize="30sp"
            android:minWidth="0dp"
            android:padding="0dp"
            android:contentDescription="Back"/>
        <TextView
            android:id="@+id/add_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Add to Binder"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#FAF8F2"/>
        <ImageView
            android:id="@+id/add_game_logo"
            android:layout_width="72dp"
            android:layout_height="34dp"
            android:scaleType="fitCenter"
            android:visibility="gone"/>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/add_page"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:id="@+id/add_footer"
        android:visibility="gone"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="6dp"
        android:paddingBottom="10dp">
        <Button
            style="@style/CardFormSecondary"
            android:id="@+id/new_card_button"
            android:text="Card doesn’t exist? Add new"
            android:visibility="gone"/>
        <Button
            style="@style/CardFormPrimary"
            android:id="@+id/submit_new_card"
            android:text="Add to Binder"
            android:visibility="gone"/>
    </LinearLayout>
</LinearLayout>
